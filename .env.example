# Mongo connection (used by the api + ingest containers; defaults match
# the compose network and don't normally need editing).
MONGO_URL=mongodb://mongo:27017
MONGO_DB=wows

# Host port the api is published on. The container always listens on 8000
# internally — this only changes the host-side mapping in docker-compose.
API_PORT=8000

# How often (seconds) the ingest loop polls wgc-download for a new patch.
INGEST_INTERVAL=1800
